{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generate-agents-md/module-writer-registry.schema.json",
  "title": "Canonical Module Writer Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_kind", "active_leases"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_kind": {"const": "local-coordination-module-writer-registry"},
    "active_leases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["module_key", "maintainer_title", "agent_id", "run_id", "lease_id", "role", "owned_paths", "lease_status"],
        "properties": {
          "module_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
          "maintainer_title": {"type": "string", "minLength": 1},
          "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
          "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
          "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
          "role": {"const": "module-maintainer"},
          "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "lease_status": {"const": "active"}
        }
      }
    }
  }
}
