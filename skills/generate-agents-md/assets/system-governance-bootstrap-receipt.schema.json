{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generate-agents-md/system-governance-bootstrap-receipt.schema.json",
  "title": "One-Time System Governance Bootstrap Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "trust_mode", "security_caveat", "explicit_user_authorization", "authorization_source", "issuer", "key_id", "key_fingerprint_sha256", "agent_handle", "assigned_model", "assigned_reasoning_effort", "role", "module_key", "stable_title", "project_root", "replay_state_path", "owned_paths", "issued_at", "not_before", "expires_at", "nonce", "receipt_id", "baseline_sha256", "policy_sha256", "candidate_sha256", "authority_matrix_sha256", "operation_id", "one_time", "post_bootstrap_authority"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "receipt_type": {"const": "system_governance_bootstrap"},
    "trust_mode": {"const": "local_controlled_same_user"},
    "security_caveat": {"const": "same_os_user_can_access_private_key_not_host_native_attestation"},
    "explicit_user_authorization": {"const": true},
    "authorization_source": {"$ref": "#/$defs/id"},
    "issuer": {"$ref": "#/$defs/id"},
    "key_id": {"$ref": "#/$defs/id"},
    "key_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "agent_handle": {"$ref": "#/$defs/id"},
    "assigned_model": {"const": "gpt-5.6-sol"},
    "assigned_reasoning_effort": {"const": "high"},
    "role": {"enum": ["implementation", "module-maintainer"]},
    "module_key": {"$ref": "#/$defs/id"},
    "stable_title": {"type": "string", "minLength": 1, "maxLength": 256},
    "project_root": {"type": "string", "pattern": "^/"},
    "replay_state_path": {"type": "string", "minLength": 1, "pattern": "^/"},
    "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "^/"}},
    "issued_at": {"$ref": "#/$defs/utc"},
    "not_before": {"$ref": "#/$defs/utc"},
    "expires_at": {"$ref": "#/$defs/utc"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "authority_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "operation_id": {"$ref": "#/$defs/id"},
    "one_time": {"const": true},
    "post_bootstrap_authority": {"const": "host-native-module-lease-required"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9/][A-Za-z0-9/._:-]{1,255}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
