{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generate-agents-md/local-controlled-module-write-lease.schema.json",
  "title": "Explicit Same-User Local Controlled Module Write Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "trust_mode", "security_caveat", "explicit_user_authorization", "authorization_mode", "authorization_source", "issuer", "key_id", "key_fingerprint_sha256", "registry_path", "project_root", "module_key", "stable_title", "agent_handle", "run_id", "assigned_model", "assigned_reasoning_effort", "role", "authorized_actions", "owned_paths", "targets", "baseline_path", "baseline_sha256", "policy_sha256", "authority_matrix_sha256", "base_candidate_sha256", "post_candidate_sha256", "code_version", "build_id", "issued_at", "not_before", "expires_at", "ttl_seconds", "nonce", "receipt_id", "lease_id"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "receipt_type": {"const": "local_controlled_module_write_lease"},
    "trust_mode": {"const": "local_controlled_same_user"},
    "security_caveat": {"const": "same_os_user_can_access_private_key_not_host_native_attestation"},
    "explicit_user_authorization": {"const": true},
    "authorization_mode": {"const": "local-controlled-same-user"},
    "authorization_source": {"$ref": "#/$defs/id"},
    "issuer": {"$ref": "#/$defs/id"},
    "key_id": {"$ref": "#/$defs/id"},
    "key_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "registry_path": {"type": "string", "pattern": "^/"},
    "project_root": {"type": "string", "pattern": "^/"},
    "module_key": {"$ref": "#/$defs/id"},
    "stable_title": {"type": "string", "minLength": 1, "maxLength": 256},
    "agent_handle": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "assigned_model": {"const": "gpt-6-astra"},
    "assigned_reasoning_effort": {"const": "medium"},
    "role": {"enum": ["implementation", "module-maintainer"]},
    "authorized_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["write", "design", "implement", "write_module_artifacts"]}},
    "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relative_path"}},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
    "baseline_path": {"$ref": "#/$defs/relative_path"},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "authority_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "base_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "post_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "code_version": {"$ref": "#/$defs/id"},
    "build_id": {"$ref": "#/$defs/id"},
    "issued_at": {"$ref": "#/$defs/utc"},
    "not_before": {"$ref": "#/$defs/utc"},
    "expires_at": {"$ref": "#/$defs/utc"},
    "ttl_seconds": {"type": "integer", "minimum": 60, "maximum": 900},
    "nonce": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "lease_id": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9/][A-Za-z0-9/._:-]{1,255}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "pre_sha256", "pre_size", "post_sha256", "post_size"], "properties": {"path": {"$ref": "#/$defs/relative_path"}, "pre_sha256": {"$ref": "#/$defs/sha256"}, "pre_size": {"type": "integer", "minimum": 0}, "post_sha256": {"$ref": "#/$defs/sha256"}, "post_size": {"type": "integer", "minimum": 0}}}
  }
}
