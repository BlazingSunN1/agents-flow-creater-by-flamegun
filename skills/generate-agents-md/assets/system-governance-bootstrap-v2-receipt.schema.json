{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generate-agents-md/system-governance-bootstrap-v2-receipt.schema.json",
  "title": "One-Time System Governance Bootstrap v2 Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "trust_mode", "security_caveat", "explicit_user_authorization", "authorization_source", "issuer", "key_id", "key_fingerprint_sha256", "agent_handle", "assigned_model", "assigned_reasoning_effort", "role", "project_root", "replay_state_path", "module_registration", "governance_targets", "issued_at", "not_before", "expires_at", "nonce", "receipt_id", "operation_id", "one_time", "baseline_sha256", "pre_policy_sha256", "post_policy_sha256", "pre_authority_matrix_sha256", "post_authority_matrix_sha256", "bootstrap_candidate_sha256", "next_authority"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "receipt_type": {"const": "system_governance_bootstrap_v2"},
    "trust_mode": {"const": "local_controlled_same_user"},
    "security_caveat": {"const": "same_os_user_can_access_private_key_not_host_native_attestation"},
    "explicit_user_authorization": {"const": true},
    "authorization_source": {"$ref": "#/$defs/id"},
    "issuer": {"$ref": "#/$defs/id"},
    "key_id": {"$ref": "#/$defs/id"},
    "key_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "agent_handle": {"$ref": "#/$defs/id"},
    "assigned_model": {"const": "gpt-5.6-sol"},
    "assigned_reasoning_effort": {"const": "high"},
    "role": {"enum": ["implementation", "module-maintainer"]},
    "project_root": {"type": "string", "pattern": "^/"},
    "replay_state_path": {"type": "string", "pattern": "^/"},
    "module_registration": {"$ref": "#/$defs/module_registration"},
    "governance_targets": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/target"}},
    "issued_at": {"$ref": "#/$defs/utc"},
    "not_before": {"$ref": "#/$defs/utc"},
    "expires_at": {"$ref": "#/$defs/utc"},
    "nonce": {"$ref": "#/$defs/sha256"},
    "receipt_id": {"$ref": "#/$defs/id"},
    "operation_id": {"$ref": "#/$defs/id"},
    "one_time": {"const": true},
    "baseline_sha256": {"$ref": "#/$defs/sha256"},
    "pre_policy_sha256": {"$ref": "#/$defs/sha256"},
    "post_policy_sha256": {"$ref": "#/$defs/sha256"},
    "pre_authority_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "post_authority_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "bootstrap_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "next_authority": {"const": "local-controlled-module-write-lease-required"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9/][A-Za-z0-9/._:-]{1,255}$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "module_registration": {"type": "object", "additionalProperties": false, "required": ["module_key", "stable_title", "owned_paths"], "properties": {"module_key": {"$ref": "#/$defs/id"}, "stable_title": {"type": "string", "minLength": 1, "maxLength": 256}, "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relative_path"}}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["path", "pre_sha256", "pre_size", "post_sha256", "post_size"], "properties": {"path": {"enum": ["AGENTS.md", "docs/agents/module-agent-governance.md"]}, "pre_sha256": {"$ref": "#/$defs/sha256"}, "pre_size": {"type": "integer", "minimum": 1}, "post_sha256": {"$ref": "#/$defs/sha256"}, "post_size": {"type": "integer", "minimum": 1}}}
  }
}
