{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/generate-agents-md/project-record-write-lease.schema.json",
  "title": "Project Record Write Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "lease_id", "module_key", "maintainer_title", "agent_id", "run_id", "target_path", "owned_paths", "agents_path", "agents_sha256", "authority_matrix_path", "authority_matrix_sha256", "lease_status"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_kind": {"enum": ["local-coordination-project-record-write-lease", "host-attested-project-record-write-lease"]},
    "lease_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "module_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"},
    "maintainer_title": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "target_path": {"type": "string", "minLength": 1},
    "owned_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "agents_path": {"const": "AGENTS.md"},
    "agents_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority_matrix_path": {"const": "AGENTS.md#machine-enforced-authority-matrix"},
    "authority_matrix_sha256": {"const": "aff241a02c51ebcf2b085602f122d7a677a41ea7cb2fa0d3db778a6886b6e643"},
    "lease_status": {"const": "active"}
  }
}
